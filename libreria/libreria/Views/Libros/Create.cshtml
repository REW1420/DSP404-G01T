@model libreria.Models.Libro
@{
    ViewData["Title"] = "Agregar Libro";
}

<h2>Agregar un nuevo libro</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="Titulo">Título</label>
        <input type="text" class="form-control" asp-for="Titulo" required />
    </div>

    <div class="form-group">
        <label for="Autor">Autor</label>
        <input type="text" class="form-control" asp-for="Autor" required />
    </div>

    <div class="form-group">
        <label for="AnioPublicacion">Año de publicación</label>
        <input type="number" class="form-control" asp-for="AnioPublicacion" required />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" href="/Libros">Cancelar</a>
</form>
